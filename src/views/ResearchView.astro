---
import { getCollection, render } from 'astro:content';
import { useT, filterByLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const items = filterByLang(await getCollection('research'), lang).sort(
  (a, b) => a.data.order - b.data.order,
);

const rendered = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Research</p>
    <h1>{t('research.title')}</h1>
    <p class="lead">{t('research.desc')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="areas">
      {rendered.map(({ item, Content }, i) => (
        <article class="area" id={item.slug}>
          <div class="area-side">
            <span class="area-num">{String(i + 1).padStart(2, '0')}</span>
            {item.data.keywords.length > 0 && (
              <div class="area-kw">
                <h2 class="kw-h">{t('research.keywords')}</h2>
                <ul class="kw-list">
                  {item.data.keywords.map((k) => (
                    <li class="tag">{k}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <div class="area-main">
            <h2 class="area-title">{item.data.title}</h2>
            <p class="area-summary">{item.data.summary}</p>
            <div class="prose">
              <Content />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .areas {
    display: grid;
    gap: clamp(40px, 6vw, 68px);
  }
  .area {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    padding-bottom: clamp(40px, 6vw, 68px);
    border-bottom: 1px solid var(--border);
  }
  .area:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .area-side {
    position: sticky;
    top: 96px;
    align-self: start;
  }
  .area-num {
    display: block;
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.28;
    line-height: 1;
    margin-bottom: 20px;
    font-variant-numeric: tabular-nums;
  }
  .kw-h {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 10px;
  }
  .kw-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .area-title {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    margin-bottom: 12px;
  }
  .area-summary {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    max-width: 62ch;
  }
  .area-main .prose {
    max-width: 68ch;
  }

  @media (max-width: 820px) {
    .area {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .area-side {
      position: static;
      display: flex;
      align-items: baseline;
      gap: 20px;
    }
    .area-num {
      margin-bottom: 0;
      font-size: 1.6rem;
    }
  }
</style>
