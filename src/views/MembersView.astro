---
import { getCollection } from 'astro:content';
import { useT, filterByLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const all = filterByLang(await getCollection('members'), lang);

const allGroups = [
  { role: 'professor', label: t('members.professor') },
  { role: 'postdoc', label: t('members.postdoc') },
  { role: 'phd', label: t('members.phd') },
  { role: 'ms', label: t('members.ms') },
  { role: 'undergrad', label: t('members.undergrad') },
  { role: 'alumni', label: t('members.alumni') },
]
  .map((g) => ({
    ...g,
    people: all
      .filter((m) => m.data.role === g.role)
      .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)),
  }))
  .filter((g) => g.people.length > 0);

// 교수 / 학생 / 졸업생 세 갈래로 묶습니다.
const tabs = [
  { key: 'faculty', label: t('members.tab.faculty'), roles: ['professor'] },
  { key: 'students', label: t('members.tab.students'), roles: ['postdoc', 'phd', 'ms', 'undergrad'] },
  { key: 'alumni', label: t('members.tab.alumni'), roles: ['alumni'] },
]
  .map((tab) => ({ ...tab, groups: allGroups.filter((g) => tab.roles.includes(g.role)) }))
  .filter((tab) => tab.groups.length > 0);

const initials = (name: string) =>
  /[가-힣]/.test(name) ? name.slice(-2) : name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Members</p>
    <h1>{t('members.title')}</h1>
    <p class="lead">{t('members.desc')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {tabs.length > 1 && (
      <div class="mtabs" role="tablist" aria-label={t('members.title')}>
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`mtab-${tab.key}`}
            aria-controls={`mpanel-${tab.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={['mtab', { 'is-active': i === 0 }]}
          >
            {tab.label}
            <span class="mtab-count">
              {tab.groups.reduce((n, g) => n + g.people.length, 0)}
            </span>
          </button>
        ))}
      </div>
    )}

    {tabs.map((tab, i) => (
      <div
        id={`mpanel-${tab.key}`}
        role="tabpanel"
        aria-labelledby={`mtab-${tab.key}`}
        hidden={i !== 0}
      >
        {tab.groups.map((group) => (
          <div class="group">
            <h2 class="group-title">
              {group.label}
              <span class="group-count">{group.people.length}</span>
            </h2>

            {group.role === 'alumni' ? (
              <ul class="alumni-list">
                {group.people.map((m) => (
                  <li class="alumni-item">
                    <strong>{m.data.name}</strong>
                    {m.data.position && <span> · {m.data.position}</span>}
                    {m.data.topic && <span class="alumni-topic">{m.data.topic}</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <div class:list={['people', { 'people--lead': group.role === 'professor' }]}>
                {group.people.map((m) => (
                  <article class:list={['card', 'person', { 'person--lead': group.role === 'professor' }]}>
                    <div class="avatar">
                      {m.data.photo ? (
                        <img src={m.data.photo} alt={m.data.name} loading="lazy" />
                      ) : (
                        <span aria-hidden="true">{initials(m.data.name)}</span>
                      )}
                    </div>
                    <div class="person-body">
                      <h3 class="person-name">{m.data.name}</h3>
                      {m.data.position && <p class="person-pos">{m.data.position}</p>}
                      {m.data.topic && (
                        <p class="person-topic">
                          <span class="person-topic-label">{t('members.topic')}</span>
                          {m.data.topic}
                        </p>
                      )}
                      {group.role !== 'professor' &&
                        m.data.education.length + m.data.career.length + m.data.activities.length >
                          0 && (
                          <div class="person-cv">
                            {[
                              { key: 'members.education', rows: m.data.education },
                              { key: 'members.career', rows: m.data.career },
                              { key: 'members.activities', rows: m.data.activities },
                            ]
                              .filter((sec) => sec.rows.length > 0)
                              .map((sec) => (
                                <div class="pcv-block">
                                  <p class="pcv-label">{t(sec.key)}</p>
                                  {sec.rows.map((r) => (
                                    <p class="pcv-row">
                                      {r.period && <span class="pcv-period">{r.period}</span>}
                                      <span class="pcv-text">{r.text}</span>
                                    </p>
                                  ))}
                                </div>
                              ))}
                          </div>
                        )}

                      {m.data.email && (
                        <a href={`mailto:${m.data.email}`} class="person-mail">{m.data.email}</a>
                      )}
                      {m.data.links.length > 0 && (
                        <ul class="person-links">
                          {m.data.links.map((l) => (
                            <li>
                              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )}

            {group.role === 'professor' && group.people.map((m) =>
              m.data.education.length + m.data.career.length + m.data.activities.length > 0 ? (
                <div class="cv">
                  {group.people.length > 1 && <h3 class="cv-who">{m.data.name}</h3>}
                  {[
                    { key: 'members.education', rows: m.data.education },
                    { key: 'members.career', rows: m.data.career },
                    { key: 'members.activities', rows: m.data.activities },
                  ]
                    .filter((sec) => sec.rows.length > 0)
                    .map((sec) => (
                      <section class="cv-block">
                        <h3 class="cv-title">{t(sec.key)}</h3>
                        <ul class="cv-list">
                          {sec.rows.map((r) => (
                            <li class="cv-row">
                              <span class="cv-period">{r.period}</span>
                              <span class="cv-text">{r.text}</span>
                            </li>
                          ))}
                        </ul>
                      </section>
                    ))}
                </div>
              ) : null,
            )}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  const mtabs = document.querySelectorAll('.mtab');
  mtabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      mtabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
    });
  });
</script>

<style>
  .cv {
    display: grid;
    gap: 26px;
    margin-top: 30px;
  }
  .person-cv {
    margin: 4px 0 14px;
    display: grid;
    gap: 10px;
  }
  .pcv-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin: 0 0 3px;
  }
  .pcv-row {
    display: grid;
    grid-template-columns: minmax(150px, max-content) 1fr;
    gap: 16px;
    margin: 0 0 4px;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .pcv-period {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pcv-text {
    color: var(--text-muted);
  }

  .cv-who {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .cv-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding-bottom: 8px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .cv-list {
    list-style: none;
    display: grid;
    gap: 9px;
  }
  .cv-row {
    display: grid;
    grid-template-columns: minmax(156px, max-content) 1fr;
    gap: 18px;
    font-size: 0.92rem;
  }
  .cv-period {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cv-text {
    color: var(--text);
  }
  @media (max-width: 560px) {
    .cv-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .cv-period {
      font-size: 0.82rem;
    }
  }

  .mtabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 6px;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--border);
  }
  .mtab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .mtab:hover {
    border-color: var(--accent-border);
    color: var(--text);
  }
  .mtab.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .mtab-count {
    font-size: 0.75rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .group + .group {
    margin-top: clamp(40px, 6vw, 60px);
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.1rem;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .group-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-faint);
    background: var(--bg-inset);
    border-radius: 999px;
    padding: 2px 9px;
  }

  /* 인원이 적어도 허전해 보이지 않도록 카드 최대 폭을 제한하고 왼쪽부터 채웁니다. */
  .people {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* 한 줄에 한 명 — 사진 왼쪽, 내용 오른쪽 */
  .person {
    display: flex;
    flex-direction: row;
    gap: 22px;
    padding: 22px 24px;
  }
  .person--lead {
    gap: 22px;
    padding: 26px;
  }
  .person-body {
    flex: 1;
    min-width: 0;
  }

  .avatar {
    width: 74px;
    height: 74px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .person--lead .avatar {
    width: 96px;
    height: 96px;
    font-size: 1.4rem;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person-name {
    font-size: 1.02rem;
    margin-bottom: 3px;
  }
  .person--lead .person-name {
    font-size: 1.2rem;
  }
  .person-position {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 8px;
  }
  .person-topic {
    font-size: 0.87rem;
    color: var(--text-muted);
    margin: 0 0 10px;
  }
  .person-topic-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 2px;
  }
  .person-links {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .person-link {
    font-size: 0.81rem;
    color: var(--text-faint);
    word-break: break-all;
  }
  .person-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .alumni-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 10px 26px;
  }
  .alumni-item {
    font-size: 0.92rem;
    color: var(--text-muted);
    padding: 9px 0;
    border-bottom: 1px dashed var(--border);
  }
  .alumni-item strong {
    color: var(--text);
  }
  .alumni-topic {
    display: block;
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  @media (max-width: 560px) {
    .person,
    .person--lead {
      flex-direction: column;
      gap: 14px;
    }
    .pcv-row {
      grid-template-columns: 1fr;
      gap: 1px;
    }
  }
</style>
