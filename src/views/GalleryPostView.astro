---
import { render, type CollectionEntry } from 'astro:content';
import { useT, usePath, formatDate, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'gallery'>;
}
const { lang, entry } = Astro.props;
const t = useT(lang);
const path = usePath(lang);
const { Content } = await render(entry);

const photos = entry.data.cover
  ? [entry.data.cover, ...entry.data.photos]
  : entry.data.photos;
---

<article class="album-page">
  <header class="page-head">
    <div class="wrap wrap-narrow">
      <a href={path('/gallery')} class="back">← {t('news.back')}</a>
      <time class="album-date" datetime={entry.data.date.toISOString()}>
        {formatDate(entry.data.date, lang)}
      </time>
      <h1>{entry.data.title}</h1>
      {entry.data.summary && <p class="lead">{entry.data.summary}</p>}
    </div>
  </header>

  <div class="section">
    <div class="wrap">
      {photos.length > 0 && (
        <div class="photo-grid">
          {photos.map((src) => (
            <a href={src} target="_blank" rel="noopener noreferrer" class="photo">
              <img src={src} alt="" loading="lazy" />
            </a>
          ))}
        </div>
      )}

      <div class="wrap-narrow album-text">
        <div class="prose"><Content /></div>
        <a href={path('/gallery')} class="btn btn--ghost back-btn">← {t('news.back')}</a>
      </div>
    </div>
  </div>
</article>

<style>
  .back {
    display: inline-block;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .album-date {
    display: block;
    font-size: 0.84rem;
    color: var(--text-faint);
    margin-bottom: 10px;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-bottom: 44px;
  }
  .photo {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .photo:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .album-text {
    margin-inline: auto;
  }
  .back-btn {
    margin-top: 36px;
  }
</style>
