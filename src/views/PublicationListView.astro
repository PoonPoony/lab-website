---
import { getCollection } from 'astro:content';
import { useT, usePath, type Lang } from '../i18n/utils';
import { PUB_CATEGORIES, listHref, detailBase, type PubKey } from '../i18n/pubs';

const fundKey = (f?: string) => (f === 'gov' ? 'projects.gov' : f === 'org' ? 'projects.org' : '');

interface Props {
  lang: Lang;
  category: PubKey;
  /** 과제 목록처럼 하위탭이 없는 화면에 씁니다. */
  standalone?: boolean;
  titleKey?: string;
  descKey?: string;
  emptyKey?: string;
}
const {
  lang,
  category,
  standalone = false,
  titleKey = 'pubs.title',
  descKey = 'pubs.desc',
  emptyKey = 'pubs.empty',
} = Astro.props;
const t = useT(lang);
const path = usePath(lang);

const all = await getCollection('publications');
const pubs = all
  .filter((p) => p.data.type === category)
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));

const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const itemBase = detailBase(category, path);
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">{standalone ? 'Projects' : 'Publications'}</p>
    <h1>{t(titleKey)}</h1>
    <p class="lead">{t(descKey)}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {!standalone && (
    <nav class="pub-tabs scroll-x" aria-label={t('pubs.title')}>
      {PUB_CATEGORIES.map((c) => (
        <a
          href={listHref(c.key, path)}
          class:list={['pub-tab', { 'is-active': c.key === category }]}
          aria-current={c.key === category ? 'page' : undefined}
        >
          {t(c.labelKey)}
          <span class="pub-tab-count">{all.filter((p) => p.data.type === c.key).length}</span>
        </a>
      ))}
    </nav>
    )}

    {pubs.length === 0 ? (
      <p class="empty">{t(emptyKey)}</p>
    ) : (
      <div class="years">
        {years.map((year) => (
          <section class="year-block">
            <h2 class="year-title">{year}</h2>
            <ol class="pub-list">
              {pubs
                .filter((p) => p.data.year === year)
                .map((p) => (
                  <li class="pub-item">
                    <a href={`${itemBase}${p.id}/`} class="pub-link">
                      {p.data.fund && (
                        <span class:list={['tag', `tag--fund-${p.data.fund}`]}>
                          {t(fundKey(p.data.fund))}
                        </span>
                      )}
                      <h3 class="pub-title">{p.data.title}</h3>
                      <p class="pub-authors">{p.data.authors}</p>
                      <p class="pub-venue">{p.data.venue}</p>
                    </a>
                  </li>
                ))}
            </ol>
          </section>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .pub-tabs {
    display: flex;
    gap: 8px;
    padding-bottom: 6px;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--border);
  }
  .pub-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .pub-tab:hover {
    border-color: var(--accent-border);
    color: var(--text);
  }
  .pub-tab.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .pub-tab-count {
    font-size: 0.75rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .year-block + .year-block {
    margin-top: 38px;
  }
  .year-title {
    font-size: 1.5rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }

  .pub-list {
    list-style: none;
    display: grid;
    gap: 0;
  }
  .pub-item {
    border-bottom: 1px solid var(--border);
  }
  .pub-link {
    display: block;
    padding: 16px 4px;
    color: inherit;
  }
  .pub-link:hover .pub-title {
    color: var(--accent);
  }
  .pub-link .tag {
    margin-bottom: 8px;
  }
  .tag--fund-gov {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent-border);
  }
  .pub-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    margin-bottom: 5px;
    transition: color 0.15s ease;
  }
  .pub-authors {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0 0 2px;
  }
  .pub-venue {
    font-size: 0.85rem;
    color: var(--text-faint);
    margin: 0;
  }

  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 50px 0;
  }
</style>
