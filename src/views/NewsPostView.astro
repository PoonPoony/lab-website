---
import { render, type CollectionEntry } from 'astro:content';
import { useT, usePath, formatDate, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'news'>;
}
const { lang, entry } = Astro.props;
const t = useT(lang);
const path = usePath(lang);
const { Content } = await render(entry);

const catLabel = (c: string) =>
  ({
    notice: t('news.notice'),
    award: t('news.award'),
    event: t('news.event'),
  })[c] ?? c;
---

<article class="post-page">
  <header class="page-head">
    <div class="wrap wrap-narrow">
      <a href={path('/news')} class="back">← {t('news.back')}</a>
      <div class="post-meta">
        <span class="tag tag--accent">{catLabel(entry.data.category)}</span>
        <time datetime={entry.data.date.toISOString()}>
          {formatDate(entry.data.date, lang)}
        </time>
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.summary && <p class="lead">{entry.data.summary}</p>}
    </div>
  </header>

  <div class="section">
    <div class="wrap wrap-narrow">
      {entry.data.thumbnail && (
        <img class="hero-img" src={entry.data.thumbnail} alt="" />
      )}

      <div class="prose">
        <Content />
      </div>


      <a href={path('/news')} class="btn btn--ghost back-btn">← {t('news.back')}</a>
    </div>
  </div>
</article>

<style>
  .back {
    display: inline-block;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    color: var(--text-faint);
    margin-bottom: 14px;
  }
  .hero-img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    margin-bottom: 34px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 38px;
  }
  .gallery-item {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .gallery-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .back-btn {
    margin-top: 44px;
  }
</style>
