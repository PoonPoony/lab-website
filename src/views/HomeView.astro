---
import { getCollection } from 'astro:content';
import { HOME_PUB_KEYS, catByKey } from '../i18n/pubs';
import {
  useT,
  usePath,
  useSite,
  filterByLang,
  formatDate,
  type Lang,
} from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = usePath(lang);
const s = useSite(lang);

const research = filterByLang(await getCollection('research'), lang).sort(
  (a, b) => a.data.order - b.data.order,
);

// 공지사항과 갤러리를 합쳐 최신순 4개
type Feed = {
  kind: 'news' | 'gallery';
  slug: string;
  title: string;
  date: Date;
  summary: string;
  badge: string;
};

const newsItems: Feed[] = filterByLang(await getCollection('news'), lang).map((p) => ({
  kind: 'news',
  slug: p.slug,
  title: p.data.title,
  date: p.data.date,
  summary: p.data.summary,
  badge: p.data.category,
}));

const galleryItems: Feed[] = filterByLang(await getCollection('gallery'), lang).map((p) => ({
  kind: 'gallery',
  slug: p.slug,
  title: p.data.title,
  date: p.data.date,
  summary: p.data.summary,
  badge: 'gallery',
}));

const feed = [...newsItems, ...galleryItems]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);

const pubs = await getCollection('publications');
const pubBase = path('/publications');

// 카테고리별 최신 4편
const pubTabs = HOME_PUB_KEYS.map((key) => {
  const cat = catByKey(key)!;
  return {
    key,
    label: t(cat.labelKey),
    href: key === 'intl-journal' ? pubBase : `${pubBase}${cat.slug}/`,
    items: pubs
      .filter((p) => p.data.type === key)
      .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
      .slice(0, 4)
      .map((p) => ({
        id: p.id,
        detail: `${pubBase}${cat.slug}/${p.id}/`,
        year: p.data.year,
        title: p.data.title,
        authors: p.data.authors,
        venue: p.data.venue,
      })),
  };
}).filter((g) => g.items.length > 0);

const catLabel = (c: string) =>
  ({
    notice: t('news.notice'),
    award: t('news.award'),
    event: t('news.event'),
    gallery: t('gallery.title'),
  })[c] ?? c;
---

<!-- ================= HERO ================= -->
<section class="hero">

  <div class="wrap hero-inner">
    <div class="hero-main">
      <div class="hero-headline">
        <span class="hero-logo"><img src="/logo1.png" alt="" /></span>
        <div class="hero-headline-text">
          <p class="hero-eyebrow">{s.university}</p>
          <h1 class="hero-title">{s.labName}</h1>
          <p class="hero-tagline">{s.tagline}</p>
        </div>
      </div>
      <ul class="hero-keys">
        {s.keywords.map((k) => <li>{k}</li>)}
      </ul>
    </div>

    <aside class="hero-join">
      <p class="hero-join-badge">{t('contact.join.badge')}</p>
      <h2 class="hero-join-title">{t('contact.join.title')}</h2>
      <p class="hero-join-desc">{t('contact.join.desc')}</p>
      <a href={`mailto:${s.email}`} class="btn btn--primary hero-join-cta">
        {t('contact.join.cta')} →
      </a>
    </aside>
  </div>

</section>

<!-- ================= 연구 분야 + 최근 소식 (2단) ================= -->
<section class="section duo">
  <div class="wrap">
    <div class="duo-grid">

      <div class="tcol">
        <div class="tcol-head">
          <p class="eyebrow">Research</p>
          <h2 class="tcol-title">{t('home.research.title')}</h2>
          <a href={path('/research')} class="link-more">{t('home.more')} →</a>
        </div>
        <ul class="tlist">
          {research.slice(0, 4).map((item, i) => (
            <li class="titem">
              <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="ttitle">{item.data.title}</h3>
                <p class="tsummary">{item.data.summary}</p>
                {item.data.keywords.length > 0 && (
                  <ul class="kw-list">
                    {item.data.keywords.slice(0, 3).map((k) => <li class="tag">{k}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="tcol">
        <div class="tcol-head">
          <p class="eyebrow">News</p>
          <h2 class="tcol-title">{t('home.news.title')}</h2>
          <span class="tcol-links">
            <a href={path('/news')} class="link-more">{t('nav.news')} →</a>
            <a href={path('/gallery')} class="link-more">{t('nav.gallery')} →</a>
          </span>
        </div>
        <ul class="tlist">
          {feed.map((item) => (
            <li class="titem titem--link">
              <a href={`${path(item.kind === 'gallery' ? '/gallery' : '/news')}${item.slug}/`}>
                <div class="tnews-meta">
                  <span class:list={['tag', item.kind === 'gallery' ? 'tag--gallery' : 'tag--accent']}>
                    {catLabel(item.badge)}
                  </span>
                  <time datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>
                </div>
                <h3 class="ttitle">{item.title}</h3>
                {item.summary && <p class="tsummary">{item.summary}</p>}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<!-- ================= 주요 논문 (전체 폭) ================= -->
{pubTabs.length > 0 && (
  <section class="section section--soft pubs">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Publications</p>
          <h2 class="h-section">{t('home.pubs.title')}</h2>
        </div>
      </div>

      <div class="ptabs" role="tablist" aria-label={t('home.pubs.title')}>
        {pubTabs.map((g, i) => (
          <button
            type="button"
            role="tab"
            id={`ptab-${g.key}`}
            aria-controls={`ppanel-${g.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={['ptab', { 'is-active': i === 0 }]}
          >
            {g.label}
          </button>
        ))}
      </div>

      {pubTabs.map((g, i) => (
        <div
          id={`ppanel-${g.key}`}
          role="tabpanel"
          aria-labelledby={`ptab-${g.key}`}
          class="ppanel"
          hidden={i !== 0}
        >
          <ol class="pub-list">
            {g.items.map((p) => (
              <li class="pub-item">
                <span class="pub-year">{p.year}</span>
                <a href={p.detail} class="pub-body">
                  <h3 class="pub-title">{p.title}</h3>
                  <p class="pub-authors">{p.authors}</p>
                  <p class="pub-venue">{p.venue}</p>
                </a>
              </li>
            ))}
          </ol>
          <a href={g.href} class="link-more ppanel-more">{g.label} {t('home.more')} →</a>
        </div>
      ))}
    </div>
  </section>
)}

<script>
  const tabs = document.querySelectorAll('.ptab');
  let hoverTimer = 0;

  function activate(tab: Element) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
      const panel = document.getElementById(t.getAttribute('aria-controls') || '');
      if (panel) panel.hidden = !on;
    });
  }

  tabs.forEach((tab) => {
    // 클릭 — 터치 기기에서는 이쪽만 동작합니다.
    tab.addEventListener('click', () => {
      window.clearTimeout(hoverTimer);
      activate(tab);
    });

    // 마우스를 올리면 전환. 지나가듯 스쳐도 바뀌지 않도록 잠깐 기다립니다.
    tab.addEventListener('mouseenter', () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => activate(tab), 120);
    });
    tab.addEventListener('mouseleave', () => window.clearTimeout(hoverTimer));

    // 키보드로 탭 이동할 때도 같이 바뀌게
    tab.addEventListener('focus', () => activate(tab));
  });
</script>


<style>
  /* ---- 3단 요약 ---- */
  .duo {
    padding-block: clamp(36px, 4.4vw, 52px);
  }
  .pubs {
    padding-top: clamp(36px, 4.4vw, 52px);
  }
  .duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: stretch;
  }
  .tcol {
    display: flex;
    flex-direction: column;
  }
  .tcol-head {
    padding-bottom: 14px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .tcol-title {
    font-size: 1.25rem;
    margin-bottom: 2px;
  }
  .tcol-head .link-more {
    position: absolute;
    right: 0;
    bottom: 14px;
    font-size: 0.82rem;
  }
  .tcol-links {
    position: absolute;
    right: 0;
    bottom: 14px;
    display: flex;
    gap: 16px;
  }
  .tcol-links .link-more {
    position: static;
  }
  .tag--gallery {
    background: var(--bg-inset);
    color: var(--text-muted);
    border-color: var(--border-strong);
  }
  .tlist {
    list-style: none;
    flex: 1;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
  }
  .titem {
    display: grid;
    grid-template-columns: 46px 1fr;
    align-content: start;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
  }
  .titem--link {
    display: block;
  }
  .tnum {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .ttitle {
    font-size: 0.95rem;
    line-height: 1.45;
    margin-bottom: 4px;
  }
  .ttitle--pub { font-weight: 600; font-size: 0.9rem; }
  .ttitle a:hover { color: var(--accent); }
  .tmeta {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
  }
  .tnews-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    color: var(--text-faint);
    margin-bottom: 7px;
  }
  .titem--link a:hover .ttitle { color: var(--accent); }

  .tsummary {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0 0 9px;
  }
  .titem .kw-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .titem--link a:hover .tsummary { color: var(--text-muted); }

  @media (max-width: 880px) {
    .duo-grid { grid-template-columns: 1fr; gap: 44px; }
  }

  /* ---- hero ---- */
  .hero {
    position: relative;
    background: linear-gradient(168deg, #E8EFF7 0%, #CFDCEA 100%);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(40px, 4.6vw, 56px) clamp(39px, 4.5vw, 55px);
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    max-width: var(--wrap);
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(280px, 27.5vw, 352px);
    gap: clamp(20px, 2.3vw, 30px);
    align-items: center;
  }
  .hero-main {
    min-width: 0;
  }

  /* ---- 히어로 안 학생 모집 카드 ---- */
  .hero-join {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.78);
    padding: 18px 20px 16px;
    box-shadow: 0 10px 28px rgba(20, 34, 58, 0.07);
  }
  .hero-join-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    padding: 3px 10px;
    margin-bottom: 9px;
  }
  .hero-join-title {
    font-size: 1rem;
    line-height: 1.42;
    margin-bottom: 5px;
  }
  .hero-join-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 0 10px;
  }
  .hero-join-cta {
    width: 100%;
    justify-content: center;
    padding-block: 10px;
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  .hero-eyebrow {
    font-size: 0.84rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-bottom: 4px;
  }
  .hero-headline {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 22px);
    margin-bottom: 22px;
  }
  .hero-headline-text {
    min-width: 0;
  }
  .hero-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(76px, 10vw, 112px);
    height: clamp(76px, 10vw, 112px);
  }
  .hero-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-title {
    font-size: clamp(1.9rem, 4.6vw, 2.9rem);
    color: var(--ink);
    margin-bottom: 6px;
    max-width: 18ch;
    min-width: 0;
    line-height: 1.14;
  }
  @media (max-width: 560px) {
    .hero-headline {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
  .hero-tagline {
    font-size: clamp(1.02rem, 2.1vw, 1.22rem);
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0;
  }
  .hero-lead {
    max-width: 54ch;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    margin-bottom: 18px;
  }

  .hero-keys {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
  }
  .hero-keys li {
    font-size: 0.81rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 11px;
    white-space: nowrap;
  }


  /* ---- 공통 섹션 헤더 ---- */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
    flex-wrap: wrap;
  }
  .section-head .lead {
    margin: 10px 0 0;
  }

  /* ---- 연구 분야 ---- */
  .research-grid {
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  }
  @media (max-width: 400px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }
  .research-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .research-card {
    border-top: 3px solid var(--accent);
  }
  .research-num {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .research-card .tag {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent-border);
  }
  .research-title {
    font-size: 1.08rem;
    margin-bottom: 9px;
  }
  .research-summary {
    color: var(--text-muted);
    font-size: 0.93rem;
    margin-bottom: 16px;
    flex: 1;
  }
  .kw-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ---- 뉴스 ---- */
  .news-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .news-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .news-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.79rem;
    color: var(--text-faint);
    padding: 22px 24px 0;
  }
  .news-title {
    font-size: 1.03rem;
    padding: 10px 24px 0;
  }
  .news-summary {
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 8px 24px 24px;
    margin: 0;
  }
  .news-card:not(:has(.news-summary)) .news-title {
    padding-bottom: 24px;
  }

  /* ---- 논문 ---- */
  .pub-list {
    list-style: none;
    display: grid;
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  /* ---- 주요 논문 탭 ---- */
  .ptabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .ptab {
    padding: 8px 15px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .ptab:hover {
    border-color: var(--accent-border);
    color: var(--text);
  }
  .ptab.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .ppanel-more {
    display: inline-block;
    margin-top: 18px;
    font-size: 0.85rem;
  }
  .pub-body:hover .pub-title {
    color: var(--accent);
  }
  .pub-title {
    transition: color 0.15s ease;
  }
  .pub-item {
    display: grid;
    grid-template-columns: 68px 1fr;
    gap: 18px;
    padding: 22px 26px;
    background: var(--surface);
  }
  .pub-year {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }
  .pub-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    margin-bottom: 6px;
  }
  .pub-title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pub-authors {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0 0 2px;
  }
  .pub-venue {
    font-size: 0.86rem;
    color: var(--text-faint);
    font-style: italic;
    margin: 0;
  }


  @media (max-width: 560px) {
    .pub-item {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
