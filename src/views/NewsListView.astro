---
import { getCollection } from 'astro:content';
import { useT, usePath, filterByLang, formatDate, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = usePath(lang);

const posts = filterByLang(await getCollection('news'), lang).sort(
  (a, b) =>
    Number(b.data.pinned) - Number(a.data.pinned) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const catLabel = (c: string) =>
  ({
    notice: t('news.notice'),
    award: t('news.award'),
    event: t('news.event'),
    gallery: t('news.gallery'),
  })[c] ?? c;
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">News</p>
    <h1>{t('news.title')}</h1>
    <p class="lead">{t('news.desc')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {posts.length === 0 ? (
      <p class="empty">{t('news.empty')}</p>
    ) : (
      <div class="grid grid--2">
        {posts.map((post) => (
          <a href={`${path('/news')}${post.slug}/`} class="card post">
            {post.data.thumbnail && (
              <img class="post-thumb" src={post.data.thumbnail} alt="" loading="lazy" />
            )}
            <div class="post-body">
              <div class="post-meta">
                {post.data.pinned && <span class="tag tag--accent">{t('news.pinned')}</span>}
                <span class="tag">{catLabel(post.data.category)}</span>
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date, lang)}
                </time>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .post {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .post-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .post-body {
    padding: 24px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.79rem;
    color: var(--text-faint);
    margin-bottom: 11px;
  }
  .post-title {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .post-summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
  }
  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 60px 0;
  }
</style>
