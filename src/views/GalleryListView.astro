---
import { getCollection } from 'astro:content';
import { useT, usePath, filterByLang, formatDate, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = usePath(lang);

const albums = filterByLang(await getCollection('gallery'), lang).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Gallery</p>
    <h1>{t('gallery.title')}</h1>
    <p class="lead">{t('gallery.desc')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    {albums.length === 0 ? (
      <p class="empty">{t('gallery.empty')}</p>
    ) : (
      <div class="grid grid--3">
        {albums.map((a) => (
          <a href={`${path('/gallery')}${a.slug}/`} class="card album">
            <div class="album-cover">
              {a.data.cover ? (
                <img src={a.data.cover} alt="" loading="lazy" />
              ) : (
                <span class="album-ph" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none"
                       stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="4" width="18" height="16" rx="2.5"/>
                    <circle cx="8.5" cy="9.5" r="1.8"/>
                    <path d="M3.5 17.5l4.8-4.6a2 2 0 0 1 2.7 0l3.4 3.2a2 2 0 0 0 2.7 0l2-1.8"/>
                  </svg>
                </span>
              )}
              {a.data.photos.length > 0 && (
                <span class="album-count">{a.data.photos.length}{t('gallery.photos')}</span>
              )}
            </div>
            <div class="album-body">
              <time datetime={a.data.date.toISOString()}>{formatDate(a.data.date, lang)}</time>
              <h2 class="album-title">{a.data.title}</h2>
              {a.data.summary && <p class="album-summary">{a.data.summary}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .album {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .album-cover {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--bg-inset);
    border-bottom: 1px solid var(--border);
    display: grid;
    place-items: center;
  }
  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .album-ph {
    color: var(--text-faint);
    opacity: 0.7;
  }
  .album-count {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fff;
    background: rgba(20, 26, 36, 0.62);
    border-radius: 999px;
    padding: 3px 10px;
    backdrop-filter: blur(4px);
  }
  .album-body {
    padding: 18px 22px 22px;
  }
  .album-body time {
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .album-title {
    font-size: 1.03rem;
    margin: 6px 0 6px;
  }
  .album-summary {
    font-size: 0.89rem;
    color: var(--text-muted);
    margin: 0;
  }
  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 60px 0;
  }
</style>
