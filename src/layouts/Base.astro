---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useT, useSite, altLangUrl, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  current?: string;
}

const { lang, title, description, current } = Astro.props;
const t = useT(lang);
const s = useSite(lang);

const fullTitle = title === s.labName ? `${s.labName} | ${s.university}` : `${title} | ${s.labName}`;
const desc = description ?? s.heroLead;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const altHref = new URL(altLangUrl(Astro.url, lang), Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={lang === 'ko' ? 'ko-KR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'ko' ? 'en' : 'ko'} href={altHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap"
    />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skip')}</a>
    <Header lang={lang} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
  }
</style>
