---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import PublicationPostView from '../../../../views/PublicationPostView.astro';
import { catByKey } from '../../../../i18n/pubs';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((entry) => ({
    params: { category: catByKey(entry.data.type)!.slug, slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const lang = 'en' as const;
---
<Base lang={lang} title={entry.data.title} description={entry.data.venue} current="publications">
  <PublicationPostView lang={lang} entry={entry} />
</Base>
