---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PublicationPostView from '../../views/PublicationPostView.astro';
import { PROJECT_KEY } from '../../i18n/pubs';

export async function getStaticPaths() {
  const items = (await getCollection('publications')).filter(
    (e) => e.data.type === PROJECT_KEY,
  );
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const lang = 'ko' as const;
---
<Base lang={lang} title={entry.data.title} description={entry.data.venue} current="projects">
  <PublicationPostView lang={lang} entry={entry} />
</Base>
