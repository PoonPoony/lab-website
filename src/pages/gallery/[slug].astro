---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GalleryPostView from '../../views/GalleryPostView.astro';
import { filterByLang } from '../../i18n/utils';

export async function getStaticPaths() {
  const albums = filterByLang(await getCollection('gallery'), 'ko');
  return albums.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const lang = 'ko' as const;
---

<Base lang={lang} title={entry.data.title} description={entry.data.summary} current="gallery">
  <GalleryPostView lang={lang} entry={entry} />
</Base>
