---
import { useT, usePath, useSite, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = usePath(lang);
const s = useSite(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <p class="footer-name">{s.labName}</p>
      <p class="footer-univ">{s.university}</p>
      <p class="footer-tagline">{s.tagline}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">{t('contact.title')}</h2>
      <dl class="contact-list">
        <div>
          <dt>{t('contact.address')}</dt>
          <dd>{s.address}</dd>
        </div>
        <div>
          <dt>{t('contact.email')}</dt>
          <dd><a href={`mailto:${s.email}`}>{s.email}</a></dd>
        </div>
        <div>
          <dt>{t('contact.phone')}</dt>
          <dd><a href={`tel:${s.phone.replace(/[^+\d]/g, '')}`}>{s.phone}</a></dd>
        </div>
      </dl>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h2 class="footer-h">{t('nav.home')}</h2>
      <ul class="footer-links">
        <li><a href={path('/research')}>{t('nav.research')}</a></li>
        <li><a href={path('/members')}>{t('nav.members')}</a></li>
        <li><a href={path('/publications')}>{t('nav.publications')}</a></li>
        <li><a href={path('/news')}>{t('nav.news')}</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <small>© {year} {s.labName}. {t('footer.rights')}</small>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    padding-top: clamp(48px, 6vw, 72px);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.2fr 0.8fr;
    gap: 40px;
    padding-bottom: 44px;
  }

  .footer-name {
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .footer-univ {
    font-size: 0.9rem;
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.6);
  }
  .footer-tagline {
    font-size: 0.9rem;
    max-width: 34ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-h {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 16px;
  }

  .contact-list {
    margin: 0;
    display: grid;
    gap: 12px;
    font-size: 0.9rem;
  }
  .contact-list dt {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.42);
    margin-bottom: 2px;
  }
  .contact-list dd {
    margin: 0;
  }
  .contact-list a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-links {
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 0.9rem;
  }
  .footer-links a:hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 20px 26px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
