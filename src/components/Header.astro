---
import { useT, usePath, useSite, altLangUrl, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  current?: string;
}
const { lang, current = '' } = Astro.props;
const t = useT(lang);
const path = usePath(lang);
const s = useSite(lang);

const nav = [
  { key: 'research', href: path('/research'), label: t('nav.research') },
  { key: 'members', href: path('/members'), label: t('nav.members') },
  { key: 'publications', href: path('/publications'), label: t('nav.publications') },
  { key: 'news', href: path('/news'), label: t('nav.news') },
];

const otherLang: Lang = lang === 'ko' ? 'en' : 'ko';
const switchHref = altLangUrl(Astro.url, lang);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={path('/')} class="brand" aria-label={s.labName}>
      <span class="brand-mark" aria-hidden="true">
        <img src="/logo1.png" width="36" height="36" alt="" />
      </span>
      <span class="brand-text">
        <strong>{s.labName}</strong>
        <small>{s.university}</small>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': current === item.key }]}
          aria-current={current === item.key ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={switchHref} class="lang-btn" hreflang={otherLang} lang={otherLang}>
        {t('lang.switch')}
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden aria-label="Mobile">
    <div class="wrap">
      {nav.map((item) => (
        <a href={item.href} class="mobile-link">{item.label}</a>
      ))}
      <a href={switchHref} class="mobile-link mobile-link--lang" hreflang={otherLang} lang={otherLang}>
        {t('lang.switch')}
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }
  .brand-mark {
    color: var(--accent);
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .brand-text strong {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .brand-text small {
    font-size: 0.74rem;
    color: var(--text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    padding: 8px 13px;
    border-radius: 8px;
    font-size: 0.91rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-inset);
  }
  .nav-link.is-active {
    color: var(--accent);
    font-weight: 600;
  }

  .lang-btn {
    margin-left: 10px;
    padding: 7px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .lang-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 10px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 9px;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    height: 1.7px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6.7px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6.7px) rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--bg);
    padding-block: 8px 16px;
  }
  .mobile-nav .wrap {
    display: flex;
    flex-direction: column;
  }
  .mobile-link {
    padding: 13px 4px;
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .mobile-link--lang {
    border-bottom: none;
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: flex;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
